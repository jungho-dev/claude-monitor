// rust-agents-proxy.rc
// 실행 파일 아이콘·버전 정보·manifest 리소스 (build.rs 가 windres 로 컴파일, 버전 매크로는 Cargo.toml 값)
// rust-agents-proxy.manifest 는 build.rs 가 OUT_DIR 에 생성하고 --include-dir 로 찾음

1 ICON "rust-agents-proxy.ico"
1 24 "rust-agents-proxy.manifest"

1 VERSIONINFO
FILEVERSION RAP_VER_MAJOR, RAP_VER_MINOR, RAP_VER_PATCH, 0
PRODUCTVERSION RAP_VER_MAJOR, RAP_VER_MINOR, RAP_VER_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "CompanyName", "rust-agents-proxy contributors"
            VALUE "FileDescription", "Localhost hub for Claude Code agents"
            VALUE "FileVersion", RAP_VER_TEXT
            VALUE "InternalName", "rust-agents-proxy"
            VALUE "LegalCopyright", "Licensed under Apache-2.0"
            VALUE "OriginalFilename", "rust-agents-proxy.exe"
            VALUE "ProductName", "rust-agents-proxy"
            VALUE "ProductVersion", RAP_VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
